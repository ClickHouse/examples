PGHOST=YOUR_DIRECT_CLOUD_POSTGRES_HOSTNAME
PGPORT=5432
PGDATABASE=postgres
PGUSER=webhook_receiver
PGPASSWORD=YOUR_RECEIVER_PASSWORD
PGSSLROOTCERT=/absolute/path/to/postgres-ca.pem
PORT=3000
# Generate distinct random tokens with openssl rand -hex 32. Server binds tokens
# to seeded integrations; callers cannot specify their integration ID.
INTEGRATION_TOKENS='{"00000000-0000-4000-8000-000000000001":"YOUR_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS","00000000-0000-4000-8000-000000000002":"ANOTHER_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS"}'
# Tests only, on a dedicated service:
# TEST_MIGRATOR_PASSWORD=YOUR_MIGRATOR_PASSWORD
# TEST_WORKER_PASSWORD=YOUR_WORKER_PASSWORD
# TEST_WRONG_CA=/absolute/path/to/unrelated-ca.pem
