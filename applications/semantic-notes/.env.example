PGHOST=your-cloud-postgres-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=semantic_app
PGPASSWORD=replace-with-runtime-role-password
PGSSLMODE=verify-full
PGSSLROOTCERT=/absolute/path/to/ca.pem
MODEL_CACHE_DIR=/absolute/path/to/model-cache
HF_HUB_OFFLINE=1
TOKENIZERS_PARALLELISM=false
APP_ORIGIN=http://127.0.0.1:8000
