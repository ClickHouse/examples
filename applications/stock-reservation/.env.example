# Runtime role only. Percent-encode username/password components; no URL query parameters.
DATABASE_URL=postgres://stock_reservation_app:REPLACE_ME@YOUR_HOST:5432/postgres
# Download this CA from ClickHouse Cloud. TLS and hostname verification are mandatory.
PG_CA_CERT_PATH=.deployment/postgres-ca.pem
PG_MAX_CONNECTIONS=5

# Maps server-owned client IDs to unique, randomly generated Bearer tokens (32–256 chars).
# Generate each token with: openssl rand -hex 32
API_KEYS_JSON='{"warehouse-demo":"REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_TOKEN"}'

HOST=127.0.0.1
PORT=3000

# Only for explicitly invoked integration tests against a dedicated example service:
# TEST_ADMIN_DATABASE_URL=postgres://postgres:REPLACE_ME@YOUR_HOST:5432/postgres
