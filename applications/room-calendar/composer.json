{
  "name": "clickhouse-examples/room-calendar",
  "description": "Revisioned room reservations protected by a PostgreSQL range exclusion constraint",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.3 <8.5",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-mbstring": "*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/uid": "7.4.*",
    "symfony/yaml": "7.4.*",
    "doctrine/orm": "^3.7.3",
    "doctrine/dbal": "^4.5.0",
    "doctrine/doctrine-bundle": "^2.19.1",
    "doctrine/doctrine-migrations-bundle": "^3.7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "12.5.37"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "DoctrineMigrations\\": "migrations/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find src migrations public bin tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  }
}
