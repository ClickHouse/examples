{
  "name": "product-graphql",
  "private": true,
  "type": "module",
  "scripts": {
    "schema": "bun scripts/schema.ts",
    "codegen": "bun run schema && graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "start": "bun src/server/index.ts",
    "test": "bun test tests/validation.test.ts",
    "test:integration": "bun test tests/database.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@pothos/core": "4.15.1",
    "graphql-yoga": "5.24.1",
    "graphql": "16.12.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "dataloader": "2.2.3",
    "urql": "5.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.3",
    "@graphql-codegen/client-preset": "6.2.0",
    "@types/pg": "8.23.1",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.2",
    "typescript": "7.0.2",
    "@playwright/test": "1.63.0"
  }
}
