# Copy to a private file outside Git; export with set -a when sourcing.
PGHOST=your-service-hostname
PGPORT=5432
PGDATABASE=postgres
PGUSER=directory_app
PGPASSWORD=replace-with-runtime-password
PGSSLROOTCERT=/absolute/path/ca.pem
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters
NUXT_APP_ORIGIN=https://directory.example.test
# HTTPS deployment defaults. Both must change only for explicit loopback HTTP.
NUXT_SESSION_SECURE=true
NUXT_SESSION_COOKIE_SECURE=true
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
NODE_ENV=production
