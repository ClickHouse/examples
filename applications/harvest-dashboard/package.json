{
  "name": "harvest-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/@react-router/dev/bin.js dev --host 127.0.0.1",
    "build": "react-router build",
    "start": "node --env-file=.env ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "tsx --test tests/validation.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test tests/database.test.ts",
    "test:browser": "node --env-file=.env ./node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@mantine/core": "9.6.3",
    "@mantine/form": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
