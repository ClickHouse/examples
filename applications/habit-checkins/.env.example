PGHOST=your-cloud-service-hostname
PGPORT=5432
PGDATABASE=postgres
PGUSER=habit_app
PGPASSWORD=replace-with-runtime-password
PGSSLMODE=verify-full
PGSSLROOTCERT=/absolute/path/cloud-ca.pem
APP_TOKENS=user-a:replace-with-random-token-at-least-32-characters,user-b:another-random-token-at-least-32-characters
APP_URL=http://127.0.0.1:8080
