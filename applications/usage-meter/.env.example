PGHOST=YOUR_DIRECT_CLOUD_POSTGRES_HOSTNAME
PGPORT=5432
PGDATABASE=postgres
PGUSER=usage_app
PGPASSWORD=YOUR_RUNTIME_PASSWORD
PGSSLROOTCERT=/absolute/path/to/postgres-ca.pem
CLICKHOUSE_URL=https://YOUR_CLICKHOUSE_HOSTNAME:8443
CLICKHOUSE_USER=usage_reports
CLICKHOUSE_PASSWORD=YOUR_REPORT_PASSWORD
ACCOUNT_TOKENS='{"00000000-0000-4000-8000-000000000001":"YOUR_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS","00000000-0000-4000-8000-000000000002":"ANOTHER_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS"}'
PORT=3000
# Tests only: RUN_CLOUD_TESTS=1 and TEST_WRONG_CA=/absolute/path/to/unrelated-ca.pem
# Keep migration, publication/CDC and administrator passwords out of this file.
