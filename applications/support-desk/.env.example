# Load explicitly with set -a; source .deployment/app.env; set +a
RAILS_ENV=development
SECRET_KEY_BASE=REPLACE_WITH_128_HEX_CHARACTERS
COOKIE_SECURE=0
PGHOST=YOUR_SERVICE_DIRECT_HOSTNAME
PGPORT=5432
PGDATABASE=postgres
PGUSER=support_desk_app
PGPASSWORD=YOUR_RUNTIME_PASSWORD
PGSSLROOTCERT=/absolute/path/to/.deployment/postgres-ca.pem
RAILS_MAX_THREADS=5
# Production requires HTTPS, COOKIE_SECURE=1, and APP_HOSTS=your-app.example
