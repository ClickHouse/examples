PGHOST=your-managed-postgres-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=invites_app
PGPASSWORD=replace-with-runtime-role-password
PGSSLROOTCERT=/absolute/path/to/postgres-ca.pem
PORT=3000
# JSON maps existing seeded user UUIDs to distinct 32–256 character bearer credentials.
USER_TOKENS='{"00000000-0000-4000-8000-000000000001":"replace_with_32_or_more_random_characters"}'
