# Runtime-only private file. Use KEY=value lines; launch.py does not run shell syntax.
PGHOST=YOUR_MANAGED_POSTGRES_HOST
PGPORT=5432
PGDATABASE=postgres
PGSSLROOTCERT=/absolute/path/to/managed-postgres-ca.pem
PGPASSWORD=YOUR_INSPECTION_APP_PASSWORD
SESSION_SECRET=YOUR_PRIVATE_128_CHARACTER_LOWERCASE_HEX_SECRET
TZ=Pacific/Honolulu
