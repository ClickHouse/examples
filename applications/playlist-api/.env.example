PGHOST=your-cloud-hostname
PGPORT=5432
PGDATABASE=postgres
PGUSER=playlist_app
PGPASSWORD=replace-with-runtime-password
PGSSLROOTCERT=/absolute/path/to/cloud-ca.pem
ACCOUNT_A_TOKEN=replace-with-distinct-random-URL-safe-token-of-at-least-32-characters
ACCOUNT_B_TOKEN=replace-with-another-distinct-random-URL-safe-token-of-at-least-32-characters
# Optional private diagnostics for live acceptance, disabled by default.
QUERY_COUNT_EVIDENCE=0
