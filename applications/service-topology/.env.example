# Runtime login only. Cloud requires the downloaded CA file.
DATABASE_URL=postgres://topology_app:YOUR_PASSWORD@YOUR_HOST:5432/postgres
PG_CA_CERT_PATH=.deployment/postgres-ca.pem
# Enable only for a loopback development database without TLS:
# DATABASE_LOCAL=true
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
