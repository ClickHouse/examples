PGHOST=your-service-hostname
PGPORT=5432
PGDATABASE=postgres
PGUSER=expense_app
PGPASSWORD=replace-with-runtime-password
PGSSLMODE=verify-full
PGSSLROOTCERT=/absolute/path/to/cloud-ca.pem
# Generate four distinct random tokens; keep identity and role stable across rotations.
APP_TOKENS=employee-a:EMPLOYEE:replace-with-random-token-at-least-32-characters,employee-b:EMPLOYEE:another-random-token-at-least-32-characters,manager-a:MANAGER:manager-token-at-least-32-characters,manager-b:MANAGER:second-manager-token-at-least-32-characters
APP_BIND_ADDRESS=127.0.0.1
PORT=8080
