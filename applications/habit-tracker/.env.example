# Runtime connection as the least-privilege app role. No query parameters:
# TLS is configured from PGSSLROOTCERT in src/db.ts.
DATABASE_URL=postgres://habit_tracker_app:REPLACE_ME@REPLACE_HOST:5432/postgres
# CA certificate from `clickhousectl cloud postgres certs get`. Leave unset for
# local Postgres without TLS.
PGSSLROOTCERT=/absolute/path/to/.deployment/ca.pem
# "Today" is computed in this IANA time zone. Defaults to UTC.
APP_TIME_ZONE=UTC
