# Separate fields prevent connection-string sslmode from replacing TLS settings.
PGHOST=YOUR_DIRECT_CLOUD_POSTGRES_HOSTNAME
PGPORT=5432
PGDATABASE=postgres
PGUSER=catalogue_reader
PGPASSWORD=YOUR_READER_PASSWORD
PGSSLROOTCERT=/absolute/path/to/postgres-ca.pem
# Generate once: openssl rand -hex 32. Keep stable across API instances/restarts.
CURSOR_SECRET=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PORT=3000
# Integration tests only: use the migration password on a dedicated test service.
# TEST_MIGRATOR_PASSWORD=YOUR_MIGRATOR_PASSWORD
# TEST_WRONG_CA=/absolute/path/to/unrelated-test-ca.pem
