# Copy to .env and fill in the connection details from ClickHouse Cloud.
PGHOST=your-managed-postgres-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=workshop_booking_app
PGPASSWORD=replace-with-the-runtime-role-password
# Download this CA from the service's connection details. TLS is always verify-full.
PGSSLROOTCERT=./certs/postgres-ca.pem

# Map seeded attendee UUIDs to different, random server-side credentials.
# Generate each token with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
API_BEARER_TOKENS='{"11111111-1111-4111-8111-111111111111":"GENERATE_ALICE_TOKEN","22222222-2222-4222-8222-222222222222":"GENERATE_BOB_TOKEN"}'
