# Load explicitly: set -a; source .deployment/app.env; set +a
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local HTTP only; use 1 behind HTTPS in hosted operation.
DJANGO_COOKIE_SECURE=0
PGHOST=YOUR_SERVICE_DIRECT_HOSTNAME
PGPORT=5432
PGDATABASE=postgres
PGUSER=equipment_app
PGPASSWORD=YOUR_RUNTIME_PASSWORD
PGSSLROOTCERT=/absolute/path/to/.deployment/postgres-ca.pem
