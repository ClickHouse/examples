{
  "name": "clickhouse-report-history-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "cloud:create": "node scripts/cloud.mjs create",
    "cloud:setup": "node scripts/cloud.mjs setup",
    "cloud:stop": "node scripts/cloud.mjs stop",
    "demo": "node --import tsx src/cli.ts demo",
    "history": "node --import tsx src/cli.ts history",
