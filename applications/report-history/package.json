    "test:integration": "node --import tsx --test test/integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@clickhouse/client": "1.23.1", "csv-parse": "7.0.2", "dotenv": "17.4.2" },
