# Export these in a runtime-only terminal. Fill from your dedicated Cloud receipt.
PGHOST=your-service-hostname
PGPORT=5432
PGDATABASE=postgres
PGUSER=checklist_authenticator
PGPASSWORD=replace-with-runtime-password
PGSSLMODE=verify-full
PGSSLROOTCERT=/absolute/private/path/ca.pem
PGCONNECT_TIMEOUT=10
PGRST_JWT_SECRET=replace-with-generated-128-character-hex-secret
