{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        ring/ring-core {:mvn/version "1.15.5"}
        ring/ring-jetty-adapter {:mvn/version "1.15.5"}
        ring/ring-defaults {:mvn/version "0.7.1"}
        metosin/reitit-ring {:mvn/version "0.11.0"}
        hiccup/hiccup {:mvn/version "2.0.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        org.postgresql/postgresql {:mvn/version "42.7.13"}
        com.zaxxer/HikariCP {:mvn/version "7.1.0"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.17"}}
 :aliases {:run {:main-opts ["-m" "notebook.main"]}
           :security {:main-opts ["-m" "notebook.security"]}
           :tls-probe {:main-opts ["-m" "notebook.tls-probe"]}
           :plan {:main-opts ["-m" "notebook.plan"]}
           :build {:main-opts ["-m" "notebook.build"]}
           :preflight {:main-opts ["-m" "notebook.preflight"]}
           :test {:extra-paths ["test"]
                  :main-opts ["-m" "notebook.test-runner"]}}}
