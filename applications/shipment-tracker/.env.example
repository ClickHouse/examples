PGHOST=your-managed-postgres-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=shipments_app
PGPASSWORD=replace-runtime-password
PGSSLROOTCERT=/absolute/path/to/cloud-ca.pem
CLICKHOUSE_URL=https://your-analytical-service:8443
CLICKHOUSE_USER=shipments_reports
CLICKHOUSE_PASSWORD=replace-report-password
ACCOUNT_TOKENS={"00000000-0000-4000-8000-000000000001":"replace-with-a-random-token-at-least-32-characters"}
PORT=3000
# Migration/CDC/admin credentials belong in separate setup files, not this runtime file.
