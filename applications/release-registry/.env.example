PGHOST=YOUR_DIRECT_CLOUD_POSTGRES_HOSTNAME
PGPORT=5432
PGDATABASE=postgres
PGUSER=registry_app
PGPASSWORD=YOUR_RUNTIME_PASSWORD
PGSSLROOTCERT=/absolute/path/to/postgres-ca.pem
PORT=3000
PROJECT_TOKENS='{"00000000-0000-4000-8000-000000000001":"YOUR_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS","00000000-0000-4000-8000-000000000002":"ANOTHER_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS"}'
# Integration tests only: dedicated service, no production data.
# TEST_MIGRATOR_PASSWORD=YOUR_MIGRATOR_PASSWORD
# TEST_WRONG_CA=/absolute/path/to/unrelated-ca.pem
