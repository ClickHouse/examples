{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shortwave",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "vars": {
    "APP_URL": "http://localhost:4318",
    "PUBLIC_CUSTOM_DOMAINS": ""
  },
  "secrets": {
    "required": [
      "CLERK_SECRET_KEY",
      "CLICKHOUSE_URL",
      "CLICKHOUSE_USERNAME",
      "CLICKHOUSE_PASSWORD",
      "CLICKHOUSE_DATABASE",
      "CLICKHOUSE_CDC_DATABASE"
    ]
  },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": { "crons": ["* * * * *"] }
}
