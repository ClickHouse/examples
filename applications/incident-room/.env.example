PGHOST=your-service-hostname
PGPORT=5432
PGDATABASE=postgres
PGUSER=incident_app
PGPASSWORD=replace-with-runtime-password
PGSSLMODE=verify-full
PGSSLROOTCERT=/absolute/path/cloud-ca.pem
SECRET_KEY_BASE=replace-with-at-least-64-random-bytes-and-keep-stable-across-restarts
APP_ORIGIN=http://127.0.0.1:4000
PORT=4000
# Only seed command needs these; keep them out of the API environment.
SEED_CASEY_PASSWORD=replace-with-a-strong-password-at-least-16-bytes
SEED_MORGAN_PASSWORD=replace-with-a-different-strong-password
