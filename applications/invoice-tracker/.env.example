APP_NAME="Invoice tracker"
APP_ENV=local
APP_DEBUG=false
APP_KEY=REPLACE_WITH_ARTISAN_KEY
APP_URL=http://127.0.0.1:8000
DB_HOST=YOUR_SERVICE_DIRECT_HOSTNAME
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=invoice_app
DB_PASSWORD=YOUR_RUNTIME_PASSWORD
DB_SSLROOTCERT=/absolute/path/to/.deployment/postgres-ca.pem
SESSION_SECURE_COOKIE=false
# Production: APP_ENV=production, HTTPS APP_URL, SESSION_SECURE_COOKIE=true
