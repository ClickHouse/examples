# Server-side only; never prefix credentials with NEXT_PUBLIC_.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Use a plan entitled to both stock trades (T) and quotes (Q).
MASSIVE_API_KEY=
MASSIVE_WS_URL=wss://socket.massive.com/stocks
MASSIVE_SYMBOLS=AAPL,MSFT,NVDA
AUTO_START=true

# Local demo: the query and control endpoints have no authentication.
HOST=127.0.0.1
PORT=34567

# Optional Kafka copy, after each successful ClickHouse insert.
KAFKA_ENABLED=false
KAFKA_BROKER=
KAFKA_USERNAME=
KAFKA_PASSWORD=
