{
  "name": "stock-data",
  "version": "1.0.0",
  "description": "Massive stock trades and quotes with ClickHouse and a React dashboard",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently --kill-others \"node app.js\" \"npm run frontend:dev\"",
    "backend": "node app.js",
    "frontend:dev": "cd frontend && next dev --hostname 127.0.0.1 -p 3000",
    "frontend:build": "cd frontend && next build",
    "build": "npm run frontend:build",
    "test": "node --test tests/*.test.js",
    "typecheck": "cd frontend && next typegen && tsc --noEmit",
    "setup": "node scripts/setup.js",
    "test:smoke": "node scripts/smoke.js",
    "seed": "node scripts/seed.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clickhouse/click-ui": "^0.10.0",
    "@clickhouse/client": "^1.23.1",
    "@emotion/react": "^11.13.3",
    "@robloche/chartjs-plugin-streaming": "^3.1.0",
    "chart.js": "^4.4.4",
    "chartjs-adapter-moment": "^1.0.1",
    "chartjs-chart-financial": "^0.2.1",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "kafkajs": "^2.2.4",
    "moment": "^2.30.1",
    "next": "^16.3.4",
    "numeral": "^2.0.6",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.2.8",
    "react-window": "^1.8.10",
    "styled-components": "^6.1.13",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/numeral": "^2.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-window": "^1.8.8",
    "concurrently": "^8.2.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
