# Copy to config.env, fill in the values, then: source config.env
# SERVICE_ID and the native TLS endpoint come from service create/get.
# The database password is printed once at creation (or by reset-password).
# Cloud API credentials are separate: authenticate clickhousectl first.

export SERVICE_ID=''
export CH_HOST=''             # e.g. xxxx.eu-west-1.aws.clickhouse.cloud (no https://)
export CH_PORT=9440
export CH_USER=default        # dedicated disposable demo service only
export CH_PASSWORD=''         # use single quotes for shell-special characters
export SLA_MS=200             # positive integer milliseconds
export MIN_SAMPLES=100        # minimum successful requests in the last minute
export DEMO_ROWS=200000000    # start with 100000 for the smoke check
export CLAUDE_MODEL=sonnet    # Claude Code alias; override with an available model ID
