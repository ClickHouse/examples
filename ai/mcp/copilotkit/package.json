    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "10.0.5",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
