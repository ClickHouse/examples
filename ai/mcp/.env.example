# Shared SQL playground connection. See README for local and Cloud values.
CLICKHOUSE_HOST=sql-clickhouse.clickhouse.com
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=demo
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
# Required only for HTTP MCP. Generate with openssl rand -hex 32.
CLICKHOUSE_MCP_AUTH_TOKEN=
# Generic examples: openai or anthropic. ADK also supports its Google default.
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash
