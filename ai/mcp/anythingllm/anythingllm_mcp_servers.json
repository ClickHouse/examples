{
  "mcpServers": {
    "mcp-clickhouse": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--python",
        "3.13",
        "--from",
        "mcp-clickhouse==0.6.0",
        "mcp-clickhouse"
      ],
      "env": {
        "CLICKHOUSE_HOST": "sql-clickhouse.clickhouse.com",
        "CLICKHOUSE_USER": "demo",
        "CLICKHOUSE_PASSWORD": "",
        "CLICKHOUSE_PORT": "8443",
        "CLICKHOUSE_SECURE": "true"
      }
    }
  }
}
